# Copy to .env on your host, or set these as environment variables / GitHub Secrets. NEVER commit real values.
ALEX_APP_TOKEN=change-me-long-random-string
ALEX_ADMIN_TOKEN=change-me-another-long-random-string
ALEX_DATA_DIR=/data
ALEX_OWNER_NAME=Muhammad Atif

# Several keys per provider, comma separated. The pool switches to the next key automatically.
GROQ_API_KEYS=
TAVILY_API_KEYS=
NEWSDATA_API_KEYS=
SERP_API_KEYS=
OPENWEATHER_API_KEYS=
FISH_API_KEYS=

# Fish Audio voice (reference) ids per ALEX voice, e.g. {"aisha":"<id>","ali":"<id>"}
FISH_VOICE_IDS={}
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
FISH_MODEL=s2.1-pro
